    {
      "parameters": {
        "jsCode": "const userId = $('Normalizar entrada').first().json.userId;\nconst diary = $('Cargar diario').all().map((item) => item.json);\nconst favorites = $('Cargar favoritos').all().map((item) => item.json);\nconst lists = $('Cargar listas').all().map((item) => item.json);\nconst relations = $('Cargar relaciones de listas').all().map((item) => item.json);\nconst listIds = new Set(lists.map((list) => String(list.id)));\nconst userRelations = relations.filter((relation) => listIds.has(String(relation.listaId)));\nconst customLists = lists.filter((list) => list.tipo !== 'pendientes');\nconst watchlist = lists.filter((list) => list.tipo === 'pendientes');\nconst ratings = diary.map((entry) => Number(entry.calificacion)).filter(Number.isFinite);\nconst averageRating = ratings.length ? Number((ratings.reduce((sum, rating) => sum + rating, 0) / ratings.length).toFixed(2)) : null;\nreturn [{ json: { userId, generatedAt: new Date().toISOString(), totals: { diaryEntries: diary.length, favorites: favorites.length, watchlistMovies: userRelations.filter((relation) => watchlist.some((list) => String(list.id) === String(relation.listaId))).length, customLists: customLists.length, moviesInCustomLists: userRelations.filter((relation) => customLists.some((list) => String(list.id) === String(relation.listaId))).length }, averageRating } }];"
      },
