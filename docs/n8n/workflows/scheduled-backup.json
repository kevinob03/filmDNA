      "parameters": {
        "jsCode": "const collect = (name) => $(name).all().map((item) => item.json).filter((value) => value && Object.keys(value).length > 0);\nconst usuarios = collect('Cargar usuarios').map((record) => {\n  const user = { ...record };\n  delete user.password;\n  return user;\n});\nconst generatedAt = new Date().toISOString();\nreturn [{ json: { schemaVersion: 1, generatedAt, source: 'FilmDNA JSON Server', usuarios, diario: collect('Cargar diario'), favoritos: collect('Cargar favoritos'), listas: collect('Cargar listas'), listaPeliculas: collect('Cargar relaciones de listas'), movieDNA: collect('Cargar Movie DNA'), configuracionDNA: collect('Cargar configuración DNA') } }];"
      },
